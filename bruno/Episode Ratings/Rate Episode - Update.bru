meta {
  name: Rate Episode - Update
  type: http
  seq: 2
}

put {
  url: {{baseUrl}}/api/ratings/tv/{{seriesTmdbId}}/seasons/{{seasonNumber}}/episodes/{{episodeNumber}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "value": 7.5,
    "episodeName": "Pilot",
    "series": {
      "title": "Breaking Bad"
    }
  }
}

assert {
  res.status: eq 200
  res.body.value: eq 7.5
}
