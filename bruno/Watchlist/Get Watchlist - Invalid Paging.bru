meta {
  name: Get Watchlist - Invalid Paging
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/watchlist?size=0&sortDirection=sideways
  body: none
  auth: none
}

params:query {
  size: 0
  sortDirection: sideways
}

assert {
  res.status: eq 400
  res.body.message: contains size
  res.body.message: contains sortDirection
}
