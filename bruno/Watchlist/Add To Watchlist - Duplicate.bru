meta {
  name: Add To Watchlist - Duplicate
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/watchlist
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "tmdbId": {{tmdbId}},
    "mediaType": "{{mediaType}}",
    "title": "Fight Club"
  }
}

assert {
  res.status: eq 409
  res.body.status: eq 409
  res.body.message: eq Media item is already in the watchlist
}
