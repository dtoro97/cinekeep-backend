meta {
  name: Get Ratings
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/ratings?page=0&size=20&sortDirection=desc
  body: none
  auth: none
}

params:query {
  page: 0
  size: 20
  sortDirection: desc
  ~mediaType: movie
}

assert {
  res.status: eq 200
  res.body.content: isArray
  res.body.totalElements: gte 1
}
