meta {
  name: Get Favorite State
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/favorites/state?mediaType={{mediaType}}&tmdbId={{tmdbId}}
  body: none
  auth: none
}

params:query {
  mediaType: {{mediaType}}
  tmdbId: {{tmdbId}}
}

assert {
  res.status: eq 200
  res.body.favorite: eq true
}
