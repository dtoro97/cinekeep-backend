meta {
  name: Get Favorites
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/favorites?page=0&size=20&sortDirection=desc
  body: none
  auth: none
}

params:query {
  page: 0
  size: 20
  sortDirection: desc
  ~mediaType: movie
}

assert {
  res.status: eq 200
  res.body.content: isArray
  res.body.page: eq 0
  res.body.size: eq 20
  res.body.totalElements: gte 1
}
